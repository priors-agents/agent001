{
  "name": "agent001",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source agent with its own wallet and a Priors credit line on Robinhood Chain: it joins, borrows and repays on time, sells a service over x402, and talks to you from a terminal or Telegram.",
  "type": "module",
  "bin": {
    "agent001": "bin/agent001.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:fork": "node --test --test-concurrency=1 test/fork/*.test.mjs",
    "safety": "node scripts/public-safety.mjs"
  },
  "engines": {
    "node": ">=20.18"
  },
  "license": "MIT",
  "homepage": "https://github.com/priors-agents/agent001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priors-agents/agent001.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@priors/mcp": "0.8.0",
    "@priors/x402": "0.6.2",
    "@x402/core": "~2.28.0",
    "@x402/evm": "~2.28.0",
    "@x402/express": "^2.28.0",
    "ethers": "^6.13.4",
    "express": "^5.2.1"
  }
}
